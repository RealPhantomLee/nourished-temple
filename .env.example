# ─── Admin ────────────────────────────────────────────────────────────────────
# Set these before deploying. Never use defaults in production.
ADMIN_EMAIL=admin@nourishedtemple.store
ADMIN_PASSWORD=change-me-before-deploying

# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string.
# For local dev you can use Neon free tier: https://neon.tech
# For Vercel deployment, use the Neon integration in the Vercel dashboard.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# ─── Sanity CMS ───────────────────────────────────────────────────────────────
# Create a project at https://sanity.io, then fill these in.
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=your-api-token

# ─── Stripe ───────────────────────────────────────────────────────────────────
# Test keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
# Webhook secret from https://dashboard.stripe.com/test/webhooks (use stripe listen for local)
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# ─── NextAuth ─────────────────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -hex 32
NEXTAUTH_SECRET=your-nextauth-secret-generate-with-openssl-rand-hex-32

# ─── Eventbrite ───────────────────────────────────────────────────────────────
EVENTBRITE_API_TOKEN=your-eventbrite-api-token

# ─── Cron ─────────────────────────────────────────────────────────────────────
# Used to secure the /api/cron/* routes
CRON_SECRET=your-cron-secret

# ─── Site ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
